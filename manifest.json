{
  "manifest_version": 3,
  "name": "Video Unlocker Pro",
  "version": "1.1.0",
  "description": "پنل کنترل پیشرفته ویدیو با قابلیت حذف قفل — فعال‌سازی خودکار، بدون دکمه",
  "permissions": ["scripting", "activeTab", "tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["double-watch.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["main.js", "icon.svg", "popup.html", "popup.js", "player.html", "player.js"],
    "matches": ["<all_urls>"]
  }],
  "host_permissions": ["wss://*/*", "http://*/*", "https://*/*"],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}